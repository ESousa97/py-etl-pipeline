# Option A — single URL (recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Option B — discrete variables (used only when DATABASE_URL is unset)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=database_name

# Optional: print SQL to stderr (true | 1 | yes)
# SQLALCHEMY_ECHO=false

# Optional: rows per batch for bulk insert / PostgreSQL upsert (default 500)
# LOAD_BATCH_SIZE=500
